# === Общие ===
NODE_ENV=development
LOG_LEVEL=debug

# === Server ===
SERVER_PORT=40305
SERVER_HOST=0.0.0.0

# === Client ===
CLIENT_PORT=40310
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000

# === Database ===
POSTGRES_USER=gm_table
POSTGRES_PASSWORD=gm_table_password
POSTGRES_DB=gm_table
POSTGRES_PORT=5432
POSTGRES_DATA_DIR=/home/<user>/databases/gm-table-data/postgres
DATABASE_URL=postgresql://gm_table:gm_table_password@localhost:5432/gm_table

# === JWT ===
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars
JWT_EXPIRES_IN=30d

# === Uploads ===
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5

# === CORS ===
# CORS_ORIGIN=http://localhost:5173