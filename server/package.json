{
    "name": "@gm-table/server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "scripts": {
        "dev": "tsx watch --env-file=../.env src/index.ts",
        "build": "tsc --build",
        "start": "node dist/index.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "db:migrate": "prisma migrate dev",
        "db:seed": "tsx prisma/seed.ts",
        "db:studio": "prisma studio"
    },
    "dependencies": {
        "@fastify/cors": "^11.3.0",
        "@fastify/jwt": "^10.2.2",
        "@fastify/multipart": "^10.1.2",
        "@fastify/static": "^10.1.6",
        "@gm-table/shared": "workspace:*",
        "@prisma/client": "6",
        "fastify": "^5.12.5",
        "jsonwebtoken": "^9.0.3",
        "socket.io": "^4.8.4",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.3",
        "dotenv": "^18.0.4",
        "eslint-import-resolver-typescript": "^4.4.5",
        "prisma": "6",
        "tsx": "^4.23.15"
    }
}