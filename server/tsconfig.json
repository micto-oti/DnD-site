{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "composite": true,
        "tsBuildInfoFile": "./dist/.tsbuildinfo",
        "lib": ["ES2023"],
        "types": ["node"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "references": [
        { "path": "../shared" }
    ],
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}